---
import { Image } from 'astro:assets';
import bentoCode from '~/assets/bento-code.webp';
import logoVite from '~/assets/logos/Vite.js.webp';
import logoCloudflare from '~/assets/logos/Cloudflare.webp';
import logoAstro from '~/assets/logos/Astro.webp';
import logoReact from '~/assets/logos/React.webp';
import logoTailwind from '~/assets/logos/Tailwind.webp';
import logoFramer from '~/assets/logos/Motion.webp';
import Hero from '~/components/sections/Hero.astro';
import Section from '~/components/layout/Section.astro';
import { Cpu, Globe, Zap, BarChart, ShieldCheck, Settings, FileCode, Search, Moon, Eye } from 'lucide-react';
import FeaturesList from '~/components/sections/FeaturesList.astro';
import FeatureItem from '~/components/ui/FeatureItem.astro';
import Stats from '~/components/sections/Stats.astro';
import StatItem from '~/components/ui/StatItem.astro';
import CTA from '~/components/sections/CTA.astro';
import { useTranslations } from '~/i18n/utils';

export interface Props {
  lang: string;
  heroVariant?: 'centered' | 'split' | 'cinematic' | 'terminal';
}

const { lang, heroVariant = 'centered' } = Astro.props;
const t = useTranslations(lang);

const benefits = [
  { title: t['benefits.1.title'], description: t['benefits.1.desc'], icon: Settings },
  { title: t['benefits.2.title'], description: t['benefits.2.desc'], icon: FileCode },
  { title: t['benefits.3.title'], description: t['benefits.3.desc'], icon: Search },
  { title: t['benefits.4.title'], description: t['benefits.4.desc'], icon: Moon },
  { title: t['benefits.5.title'], description: t['benefits.5.desc'], icon: Eye },
  { title: t['benefits.6.title'], description: t['benefits.6.desc'], icon: Globe },
];

const stats = [
  { value: "100k+", label: t['stats.downloads'] },
  { value: "120k", label: t['stats.uptime'] },
  { value: "50M+", label: t['stats.requests'] },
  { value: "10k+", label: t['stats.support'] },
];

const homeFaqs = [
  { question: t['faq.home.1.q'], answer: t['faq.home.1.a'] },
  { question: t['faq.home.2.q'], answer: t['faq.home.2.a'] },
  { question: t['faq.home.3.q'], answer: t['faq.home.3.a'] },
  { question: t['faq.home.4.q'], answer: t['faq.home.4.a'] },
  { question: t['faq.home.5.q'], answer: t['faq.home.5.a'] },
];
---

<Hero
    variant={heroVariant}
    title="Open Source Prosthetics"
    highlight="The best technology is the one everyone can build."
    description="For the world"
    primaryCta={{ text: t['hero.getStarted'], href: `/${lang}/pricing` }}
    secondaryCta={{ text: t['hero.learnMore'], href: `/${lang}/features` }}
/>

<Section class="py-0 overflow-visible">
<Stats>
    {stats.map((stat) => (
        <StatItem value={stat.value} label={stat.label} />
    ))}
</Stats>
</Section>

<CTA
    title={t['cta.readyToLaunch']}
    description={t['cta.description']}
    primaryBtn={{ text: t['cta.primary'], href: `/${lang}/contact` }}
    secondaryBtn={{ text: t['cta.secondary'], href: `/${lang}/about` }}
    disclaimer={t['cta.disclaimer']}
/>
